<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CurrencyConverter</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/bulma.min.css" asp-append-version="true" />
</head>
<body class="hero is-fullheight">
    <div class="container">
        <main role="main" class="section">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bulma-toast/bulma-toast.min.js"></script>
    <script module src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
