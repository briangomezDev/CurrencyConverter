@using DocumentFormat.OpenXml.Math
@{
    ViewData["Title"] = "Conversor de moneda";
}

<div class="columns is-centered">
    <div class="column is-10-tablet is-8-desktop is-7-widescreen">
        <h1 class="title">Conversor de moneda</h1>
        <p class="subtitle is-6">Convierte pesos dominicanos usando la tasa de una fecha.</p>

        <form class="box" id="RateForm" method="get" asp-controller="Currency" asp-action="Index">
            <h2 class="title is-5">Tasa de cambio</h2>

            <div class="field">
                <label class="label" for="CurrencyCode">Moneda extranjera</label>
                <div class="control">
                    <div class="select is-fullwidth" id="CurrencySelect">
                        <select id="CurrencyCode" name="CurrencyCode" required>
                            <option value="" selected disabled>Selecciona una moneda</option>
                            <option value="BOLIVAR FUERTE VENEZOLANO">Bolívar venezolano</option>
                            <option value="CORONA DANESA" data-code="DKK">Corona danesa</option>
                            <option value="CORONA NORUEGA" data-code="NOK">Corona noruega</option>
                            <option value="CORONA SUECA" data-code="SEK">Corona sueca</option>
                            <option value="DERECHO ESPECIAL DE GIRO" data-code="XDR">Derecho especial de giro</option>
                            <option value="DOLAR AUSTRALIANO" data-code="AUD">Dólar australiano</option>
                            <option value="DOLAR CANADIENSE" data-code="CAD">Dólar canadiense</option>
                            <option value="DOLAR ESTADOUNIDENSE" data-code="USD">Dólar estadounidense</option>
                            <option value="EURO" data-code="EUR">Euro</option>
                            <option value="FRANCO SUIZO" data-code="CHF">Franco suizo</option>
                            <option value="LIBRA ESCOCESA">Libra escocesa</option>
                            <option value="LIBRA ESTERLINA" data-code="GBP">Libra esterlina</option>
                            <option value="REAL BRASILENO" data-code="BRL">Real brasileño</option>
                            <option value="YEN JAPONES" data-code="JPY">Yen japonés</option>
                            <option value="YUAN CHINO" data-code="CNY">Yuan chino</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="field">
                <label class="label" for="RateDate">Fecha de la tasa</label>
                <div class="control">
                    <input class="input" id="RateDate" name="RateDate" type="date" min="2004-01-01" max="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                </div>
            </div>

            <div class="field">
                <label class="label" for="LocalAmount">Monto en moneda local</label>
                <div class="field has-addons">
                    <div class="control">
                        <span class="button is-static">DOP</span>
                    </div>
                    <div class="control is-expanded">
                        <input class="input" id="LocalAmount" name="LocalAmount" type="number" min="0" step="any" required />
                    </div>
                </div>
            </div>

            <hr />

            <h2 class="title is-5">Resultado</h2>

            <div aria-live="polite">
                <p class="title is-4" id="ConvertedAmount">—</p>
                <p class="subtitle is-6" id="ForeignRate"></p>
                <p class="help" id="RateInfo"></p>
            </div>
        </form>
    </div>
</div>
@section scripts{
    <script src="~/js/currency.js"></script>
}
